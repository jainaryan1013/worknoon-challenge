# Backend env (subset of the root .env; the root file is what docker-compose reads).
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
MAX_AGENT_ITERATIONS=8
HISTORY_LIMIT=-1
SEED_ENABLED=true
FRONTEND_ORIGIN=http://localhost:8080
DATABASE_URL=postgresql+psycopg://refund:refund@db:5432/refund
