# Copy to .env and paste an API key. Read by docker-compose. See docs/components/07-infra.md §6.
# NOTE: keep comments on their own line — docker-compose env_file does not strip
# inline (end-of-line) comments, so `KEY=val # x` would set KEY to "val # x".

# LLM provider: 'openai' (default), 'anthropic', or 'fake' (deterministic, no key — test/demo only)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override; blank uses a sensible per-provider default
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
MAX_AGENT_ITERATIONS=8
# -1 = unlimited history (demo default)
HISTORY_LIMIT=-1
# Abuse backstop: max user turns per conversation (0 disables)
MAX_TURNS_PER_CONVERSATION=50
SEED_ENABLED=true
FRONTEND_ORIGIN=http://localhost:8080
POSTGRES_USER=refund
POSTGRES_PASSWORD=refund
POSTGRES_DB=refund
